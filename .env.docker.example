# Copy to .env.docker (gitignored) and fill in real secrets before running compose:
#   cp .env.docker.example .env.docker
# Loaded by docker-compose as the BACKEND container's runtime environment.

# --- JWT (generate the secret with: openssl rand -base64 32) ---
JWT_ACCESS_SECRET=REPLACE_WITH_OPENSSL_RAND_BASE64_32
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- CORS — must include the browser origin of the frontend ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# --- Mail ---
# The production images run with NODE_ENV=production and accept MAIL_TRANSPORT=smtp only.
# For the dev stack (docker compose up) you can use MAIL_TRANSPORT=console instead, which
# logs invite/reset links to stdout and ignores every SMTP_* value below.
MAIL_TRANSPORT=smtp
SMTP_HOST=REPLACE_WITH_SMTP_HOST
SMTP_PORT=587
SMTP_USER=REPLACE_WITH_SMTP_USER
SMTP_PASS=REPLACE_WITH_SMTP_PASS
# The production images refuse to boot on a MAIL_FROM that cannot receive a reply — a
# placeholder, or a reserved suffix (.local .localhost .invalid .test .example). Replace the
# dev default below with a real domain, or mail will "send" and never arrive.
MAIL_FROM="PulseDesk <noreply@pulsedesk.local>"

# --- Password reset ---
PASSWORD_RESET_TTL_HOURS=1
# Account invites (TKT-0058) — how long a set-your-password link stays valid
INVITE_TTL_HOURS=48

# --- Seed (creates the SUPER_ADMIN; required while RUN_SEED=true) ---
SUPERADMIN_EMAIL=superadmin@pulsedesk.local
SUPERADMIN_PASSWORD=REPLACE_BEFORE_DEPLOY

# --- Reverse proxy ---
# Number of proxies between the browser and this container (nginx, a load balancer,
# Cloudflare). Leave unset when the container port is reached directly. Setting it lets
# express read X-Forwarded-For, so per-IP rate limiting sees the real client instead of
# bucketing every visitor under one address. Must be a hop count, or the boot fails.
TRUST_PROXY_HOPS=

# --- Container boot behaviour (read by backend/docker-entrypoint.sh) ---
RUN_MIGRATIONS=true
RUN_SEED=true
