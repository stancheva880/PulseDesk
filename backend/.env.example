# Database (SQLite for dev; switch DATABASE_URL to a postgres:// or mysql:// URL later)
DATABASE_URL="file:./dev.db"

# Hosted SQLite over HTTP (Turso). Set BOTH or neither: with TURSO_DATABASE_URL set and
# TURSO_AUTH_TOKEN missing the app refuses to start (src/prisma/prisma-options.ts). When they
# are set they replace DATABASE_URL, and `prisma migrate deploy` no longer applies — use
# `node scripts/turso-migrate.mjs` instead. See DEPLOY.md §1.2-1.3. Leave both empty locally.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# JWT — access tokens are signed JWTs; refresh tokens are opaque (random + sha256 in DB), so no refresh secret is needed.
# Generate JWT_ACCESS_SECRET with: openssl rand -base64 32 (minimum 32 characters;
# production refuses to boot below that)
JWT_ACCESS_SECRET=REPLACE_WITH_OPENSSL_RAND_BASE64_32
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# CORS — comma-separated list of allowed origins; falls back to FRONTEND_URL when unset.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Mail
MAIL_TRANSPORT=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Production refuses to boot on a MAIL_FROM that cannot receive a reply — a placeholder, or a
# reserved suffix (.local .localhost .invalid .test .example). The value below is a dev default:
# replace it with a real domain before deploying, or mail will "send" and never arrive.
MAIL_FROM="PulseDesk <noreply@pulsedesk.local>"


# Forgot-password
PASSWORD_RESET_TTL_HOURS=1

# Account invites (TKT-0058) — how long a set-your-password link stays valid
INVITE_TTL_HOURS=48
FRONTEND_URL=http://localhost:3000

# Seed
SUPERADMIN_EMAIL=superadmin@pulsedesk.local
SUPERADMIN_PASSWORD=REPLACE_BEFORE_DEPLOY
# On-demand demo data (npm run seed:data). 12+ chars; every generated account gets it,
# so the generator refuses to run when NODE_ENV=production. Not read by the app.
SEED_DATA_PASSWORD=REPLACE_BEFORE_DEPLOY

# Error tracking (TKT-0097) — optional. Set to the backend project's DSN from Sentry
# (https://<key>@<host>/<project>) to report >=500 errors; leave empty to disable.
# Production refuses to boot on a set-but-malformed value, so a typo cannot ship as
# a deploy that looks healthy with error tracking silently off.
SENTRY_DSN=

# Server
# Number of reverse proxies in front of this app (nginx, a load balancer, Cloudflare).
# Leave unset when the app answers on its own port. Setting it lets express read
# X-Forwarded-For, so per-IP rate limiting sees the real client instead of bucketing
# every visitor under the proxy address. Must be a hop count — a non-numeric value
# fails the boot rather than silently disabling the limits.
TRUST_PROXY_HOPS=
PORT=4000
NODE_ENV=development
