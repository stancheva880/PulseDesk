// PulseDesk schema. Designed for SQLite dev / Postgres or MySQL prod.
// Conventions kept portable: cuid IDs, no SQLite-only types, no @db.* annotations,
// no provider-specific functions. Enums are stored as strings under SQLite (Prisma
// will materialize real enum types when the provider switches to Postgres).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// === ENUMS ===

enum UserRole {
  SUPER_ADMIN
  ADMIN
  EMPLOYEE
  CUSTOMER
}

enum BillingMode {
  PER_MONTH
  PER_SESSION
  // TKT-0109: time-bounded course sold at one price for the whole run.
  PER_COURSE
}

// TKT-0112: what happens to a freed spot on a full session of this class.
enum WaitlistMode {
  NONE
  FIFO_AUTO
  CLAIM
}

enum ContactRelationship {
  PARENT
  GUARDIAN
  GRANDPARENT
  SIBLING
  OTHER
}

enum SessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum AttendanceStatus {
  PENDING
  PRESENT
  ABSENT
  EXCUSED
}

// Customer-side intent — written by trainees / their guardians, never by trainers.
// Admin/trainer cells of the attendance grid use AttendanceStatus.
enum AttendanceRsvp {
  CONFIRMED
  DECLINED
  RESCHEDULE_REQUESTED
}

enum DayOfWeek {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

enum FeeStatus {
  UNPAID
  PARTIAL
  PAID
}

// === MODELS ===

// TKT-0123 removed `model Language`. It was written for a database-driven locale list and never
// read: i18n is client-only (frontend/lib/i18n.ts hardcodes `bg` and lazy-loads `en`), the
// catalogues are JSON files under frontend/locales/, and the only code that ever touched the table
// was the seed writing two rows nobody selected. Reinstate it only alongside a reader.

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships    Membership[]
  locations      Location[]
  classes        Class[]
  trainees       Trainee[]
  contactPersons ContactPerson[]
  sessions       Session[]
  attendances    Attendance[]
  classSchedules ClassSchedule[]
  fees           Fee[]
  payments       Payment[]
  refunds        Refund[]
  cards          Card[]
  cardConsumptions CardConsumption[]
  waitlistEntries WaitlistEntry[]
  waitlistClaimTokens WaitlistClaimToken[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  firstName    String?
  lastName     String?
  phone        String?
  // A small square photo as a data: URI (client-side compressed before upload — see
  // UpdateOwnProfileDto's length cap). No object storage in this stack, and Vercel's
  // filesystem is ephemeral, so a DB column is the only place this can live.
  avatarUrl    String?
  isActive     Boolean  @default(true)

  // Global platform admin — has no memberships; enters tenants via X-Tenant-Id.
  isSuperAdmin Boolean @default(false)

  // Per-tenant memberships (role lives on the membership). Empty for SUPER_ADMIN.
  memberships Membership[]

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]

  // Locations a trainer (EMPLOYEE) is assigned to.
  locations Location[] @relation("UserLocations")

  // Classes a trainer (EMPLOYEE) teaches.
  taughtClasses Class[] @relation("ClassTrainers")

  // The trainee profile this user *is* (adult Customer with their own login).
  traineeAccount Trainee? @relation("TraineeAccount")

  // Trainees this user is a guardian for (Customer guardian → child trainees).
  guardedTrainees Trainee[] @relation("TraineeGuardians")

  // Sessions this user is teaching (per-session trainer roster, may differ from class trainers).
  sessionsTaught Session[] @relation("SessionTrainers")

  // Audit trail — attendance rows this user marked.
  attendancesMarked Attendance[] @relation("AttendanceMarkedBy")

  // Audit trail — payments this user recorded.
  paymentsRecorded Payment[] @relation("PaymentRecordedBy")

  // Audit trail — refunds this user recorded.
  refundsRecorded Refund[] @relation("RefundRecordedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Email is globally unique — one email maps to exactly one account (any tenant or super admin).
}

// One row per (user, tenant): the user's role inside that tenant.
// SUPER_ADMIN never appears in a membership (enforced in service code).
model Membership {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId String
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role     UserRole

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, tenantId])
  @@index([tenantId])
}

// familyId ties a login to every token rotated from it. Omitting it on create
// starts a new family (the default fires); rotation passes the parent's value.
// Replaying a revoked token revokes the whole family — RFC 9700 4.14.2.
model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  familyId  String    @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@index([familyId])
}

// One-time password-reset tokens. Pattern mirrors RefreshToken: we store sha256 of the
// raw token, never the raw token itself. The raw token is only ever sent in the email
// link. Issuing a new reset for a user marks any prior unused tokens as used so only
// the latest link is valid.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Location {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trainers       User[]          @relation("UserLocations")
  trainees       Trainee[]       @relation("TraineeLocations")
  classes        Class[]         @relation("ClassLocations")
  sessions       Session[]
  classSchedules ClassSchedule[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Class {
  id            String      @id @default(cuid())
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  billingMode   BillingMode
  // Set when billingMode = PER_MONTH (fixed monthly fee per trainee).
  monthlyAmount Decimal?
  // Set when billingMode = PER_SESSION.
  sessionPrice  Decimal?
  // Set when billingMode = PER_COURSE (TKT-0109): the run's bounds and its one price.
  courseStart   DateTime?
  courseEnd     DateTime?
  coursePrice   Decimal?
  // TKT-0103: max trainees per session of this class; null = unlimited. Manual adds are
  // hard-gated on it; roster backfill may overflow it by design (PRD-0014 decision).
  capacity      Int?
  // TKT-0112: per-session queues exist only when this is not NONE.
  waitlistMode  WaitlistMode @default(NONE)
  // TKT-0117: customers may book/cancel/queue themselves only when this is on.
  allowSelfBooking Boolean @default(false)
  // TKT-0117: minutes before startsAt when self-service closes; null = open until start.
  // Only meaningful while allowSelfBooking is on — turning the flag off clears it.
  bookingCutoffMin Int?
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  locations Location[]      @relation("ClassLocations")
  trainers  User[]          @relation("ClassTrainers")
  trainees  Trainee[]       @relation("ClassTrainees")
  sessions  Session[]
  schedules ClassSchedule[]
  fees      Fee[]
  cards     Card[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Trainee {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  firstName   String
  lastName    String
  dateOfBirth DateTime
  phone       String?
  email       String?
  notes       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Optional: trainee may have their own User account (adult learner).
  userId String? @unique
  user   User?   @relation("TraineeAccount", fields: [userId], references: [id], onDelete: SetNull)

  // Many-to-many — a trainee can have multiple guardians; a guardian (User) can manage many trainees.
  guardians User[] @relation("TraineeGuardians")

  locations   Location[]      @relation("TraineeLocations")
  classes     Class[]         @relation("ClassTrainees")
  contacts    ContactPerson[]
  attendances Attendance[]
  fees        Fee[]
  cards       Card[]
  waitlistEntries WaitlistEntry[]

  @@index([tenantId])
  @@index([tenantId, lastName])
}

model ContactPerson {
  id           String              @id @default(cuid())
  tenantId     String
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  traineeId    String
  trainee      Trainee             @relation(fields: [traineeId], references: [id], onDelete: Cascade)
  firstName    String
  lastName     String
  relationship ContactRelationship
  phone        String?
  email        String?
  isPrimary    Boolean             @default(false)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([tenantId])
  @@index([traineeId])
}

model Session {
  id         String        @id @default(cuid())
  tenantId   String
  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classId    String
  class      Class         @relation(fields: [classId], references: [id], onDelete: Cascade)
  locationId String
  location   Location      @relation(fields: [locationId], references: [id], onDelete: Cascade)
  startsAt   DateTime
  endsAt     DateTime
  status     SessionStatus @default(SCHEDULED)
  notes      String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  // Per-session trainer roster — defaults to the class's trainers at creation time,
  // but admins can override (e.g., to assign a substitute) without editing the class.
  trainers User[] @relation("SessionTrainers")

  attendances Attendance[]
  fees        Fee[]
  waitlistEntries WaitlistEntry[]
  waitlistClaimTokens WaitlistClaimToken[]

  @@index([tenantId])
  @@index([tenantId, startsAt])
  @@index([classId])
  @@index([locationId])
}

// TKT-0112: per-session queue. Cascade from Session = deleting a session drops its queue.
model WaitlistEntry {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  traineeId String
  trainee   Trainee  @relation(fields: [traineeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  claimTokens WaitlistClaimToken[]

  @@unique([sessionId, traineeId])
  @@index([tenantId])
}

// TKT-0114: one-time claim links for CLAIM-mode openings. Only the sha256 of the token is
// stored (refresh-token discipline); the entry cascade voids tokens when the entry goes,
// and a new opening voids the session's previous tokens by sessionId.
model WaitlistClaimToken {
  id        String        @id @default(cuid())
  tenantId  String
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessionId String
  session   Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  entryId   String
  entry     WaitlistEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  tokenHash String        @unique
  createdAt DateTime      @default(now())

  @@index([tenantId])
  @@index([sessionId])
}

model Attendance {
  id          String           @id @default(cuid())
  tenantId    String
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessionId   String
  session     Session          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  traineeId   String
  trainee     Trainee          @relation(fields: [traineeId], references: [id], onDelete: Cascade)

  // Trainer/admin record of what actually happened. PENDING until a trainer marks it.
  status      AttendanceStatus @default(PENDING)

  // Customer-side intent (trainee or guardian RSVP). Independent of `status`.
  traineeRsvp AttendanceRsvp?

  notes        String?
  markedAt     DateTime?

  // Audit pointer — preserves referential integrity while the user exists.
  // Becomes NULL on user deletion (GDPR right-to-erasure).
  markedById   String?
  markedBy     User?    @relation("AttendanceMarkedBy", fields: [markedById], references: [id], onDelete: SetNull)

  // Denormalized snapshot at mark-time. Survives user deletion and renames.
  // The service writes both this and `markedById` in the same transaction.
  markedByEmailSnapshot String?
  markedByNameSnapshot  String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // TKT-0106/0107: the card visit this booking consumed, if any.
  cardConsumption CardConsumption?

  // One attendance row per (session, trainee).
  @@unique([sessionId, traineeId])
  @@index([tenantId])
  @@index([sessionId])
  @@index([traineeId])
}

// Recurring weekly slot for a class. Templates only — never queried as schedule events
// directly. The "Generate sessions" admin flow materializes concrete Session rows from
// these for a given date range. Pattern changes don't retroactively affect already-
// generated sessions.
model ClassSchedule {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classId    String
  class      Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  locationId String
  location   Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  dayOfWeek  DayOfWeek
  // 24-hour "HH:MM" — portable across providers, validated in the service.
  startTime  String
  endTime    String
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([tenantId])
  @@index([classId])
  @@index([locationId])
}

// Fee charged to a trainee for a class. Two flavors driven by Class.billingMode:
//   - PER_MONTH: sessionId = null. periodStart/periodEnd cover the chosen month
//     (admins generally pick "first day of month" → "last day"). Bulk-generated
//     in one shot per (trainee, class, period).
//   - PER_SESSION: sessionId is set; periodStart/periodEnd typically equal the
//     session's startsAt/endsAt date. Bulk-generated for a session range.
// Idempotency is enforced in the service (bulk-load + Set lookup), not via DB
// uniques — Prisma + SQLite don't support partial uniques cleanly.
model Fee {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Optional since TKT-0104 — a tenant-wide card purchase fee (TKT-0106) has no class.
  // Every other creation path still requires and validates a concrete class.
  classId   String?
  class     Class?    @relation(fields: [classId], references: [id], onDelete: Cascade)

  traineeId String
  trainee   Trainee   @relation(fields: [traineeId], references: [id], onDelete: Cascade)

  // Optional — set only for PER_SESSION fees.
  sessionId String?
  session   Session?  @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  // Inclusive period this fee covers. Stored as DateTime (UTC midnight) for portability.
  periodStart DateTime
  periodEnd   DateTime

  amount    Decimal
  status    FeeStatus @default(UNPAID)
  notes     String?

  payments  Payment[]
  // TKT-0105: money returned against this fee. Status derives from net paid (payments − refunds).
  refunds   Refund[]
  // TKT-0106: set when this fee is a card purchase; deleting the fee cascades the card (sale undone).
  card      Card?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, periodStart])
  @@index([classId])
  @@index([traineeId])
  @@index([sessionId])
}

// A single manual payment recorded against a fee. Multiple payments per fee allowed
// (partial payments). On insert/delete the FeesService recomputes Fee.status.
model Payment {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  feeId     String
  fee       Fee      @relation(fields: [feeId], references: [id], onDelete: Cascade)

  amount    Decimal
  paidAt    DateTime
  method    String?
  notes     String?

  // Audit pointer + denormalized snapshot — same pattern as Attendance.markedBy.
  recordedById            String?
  recordedBy              User?   @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  recordedByEmailSnapshot String?
  recordedByNameSnapshot  String?

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([feeId])
  @@index([tenantId, paidAt])
}

// TKT-0105: money returned against a fee. Not a negative payment and not a fee-amount
// reduction — a second ledger, so the overpay guards stay intact and status derives from
// net paid = payments − refunds. Mirrors Payment's audit shape.
model Refund {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  feeId     String
  fee       Fee      @relation(fields: [feeId], references: [id], onDelete: Cascade)

  amount     Decimal
  refundedAt DateTime
  method     String?
  notes      String?

  // Audit pointer + denormalized snapshot — same pattern as Payment.recordedBy.
  recordedById            String?
  recordedBy              User?   @relation("RefundRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  recordedByEmailSnapshot String?
  recordedByNameSnapshot  String?

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([feeId])
  @@index([tenantId, refundedAt])
}

// TKT-0106: prepaid visit card — a trainee pays a fixed price for N session visits,
// consumed one per booking (TKT-0107). classId null = any class in the tenant.
// The purchase is billed through a Fee (classId null for tenant-wide cards); deleting
// that fee cascades here — "undo the sale". PRD-0015 supersedes the old "no credit
// balance" rule.
model Card {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  traineeId   String
  trainee     Trainee   @relation(fields: [traineeId], references: [id], onDelete: Cascade)
  // Scope: null = tenant-wide, set = visits usable only for this class.
  classId     String?
  class       Class?    @relation(fields: [classId], references: [id], onDelete: Cascade)
  // The purchase fee (amount = price). One fee per card.
  feeId       String    @unique
  fee         Fee       @relation(fields: [feeId], references: [id], onDelete: Cascade)

  totalVisits Int
  price       Decimal
  // null = never expires. An expired card is unusable but stays listed.
  expiresAt   DateTime?
  // Set by cancel (TKT-0115). A cancelled card is unusable; consumptions stay.
  cancelledAt DateTime?

  consumptions CardConsumption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([traineeId])
  @@index([classId])
}

// One consumed visit: links a booking (attendance row) to the card it drew from.
// Created/deleted by the attendance write paths (TKT-0107); deleting the attendance
// returns the visit by cascading this row away.
model CardConsumption {
  id           String     @id @default(cuid())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cardId       String
  card         Card       @relation(fields: [cardId], references: [id], onDelete: Cascade)
  attendanceId String     @unique
  attendance   Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([cardId])
}
