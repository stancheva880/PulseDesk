# Root .env.example — actual app env files live in backend/.env and frontend/.env.local
# This file documents what each app expects. Never commit a populated .env.

# === Backend ===
# Database (SQLite for dev; switch DATABASE_URL to a postgres:// or mysql:// URL later)
DATABASE_URL="file:./dev.db"

# JWT — access tokens are signed JWTs; refresh tokens are opaque (random + sha256 in DB), so no refresh secret is needed.
# Generate JWT_ACCESS_SECRET with: openssl rand -base64 32
JWT_ACCESS_SECRET=REPLACE_WITH_OPENSSL_RAND_BASE64_32
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# CORS — comma-separated list of allowed origins; falls back to FRONTEND_URL when unset.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Mail (console logs invite links to stdout in dev; smtp wires nodemailer)
MAIL_TRANSPORT=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="PulseDesk <noreply@pulsedesk.local>"

# Invites
INVITE_TTL_HOURS=48

# Seed (read by prisma seed)
SUPERADMIN_EMAIL=superadmin@pulsedesk.local
SUPERADMIN_PASSWORD=REPLACE_BEFORE_DEPLOY

# Server
PORT=4000
NODE_ENV=development

# === Frontend ===
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_DEFAULT_LOCALE=bg
