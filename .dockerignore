# Build context is the repo root for every image. Keep it small and never copy
# host-built or secret artifacts into the image.

# Dependencies (reinstalled inside the Linux image)
**/node_modules

# Build outputs (rebuilt inside the image)
**/dist
**/.next
**/*.tsbuildinfo

# Database files (DB lives on a Docker volume, never baked into an image)
**/*.db
**/*.db-journal
**/*.sqlite
**/*.sqlite3

# Environment / secrets (passed at runtime via env_file / build args)
.env
.env.*
**/.env
**/.env.*

# Test / coverage artifacts
**/coverage

# Docker artifacts themselves
**/Dockerfile
docker-compose*.yml
.dockerignore

# VCS / IDE / OS
.git
.gitignore
.idea
**/.DS_Store
**/Thumbs.db

# Logs & caches
**/*.log
**/.cache
**/.eslintcache

# Docs (not needed at build time)
*.md

# Misc
*.zip